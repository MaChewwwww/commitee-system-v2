# SK Committee Management — Apache hardening for shared hosting.
# Does not rewrite or break /backend/api/*.php endpoints.

Options -Indexes

# Always deny direct HTTP to config (secrets).
RedirectMatch 403 (?i)/backend/config(/|$)

# Deny common dump/secret extensions anywhere in the tree.
<FilesMatch "(?i)\.(env|sql|bak|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Uncomment after HTTPS is confirmed on the live domain:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
