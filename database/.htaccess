# Block database tooling in production.
# Local XAMPP (Host: localhost) remains reachable for CLI/HTTP test harnesses.
<IfModule mod_setenvif.c>
  SetEnvIf Host "^localhost(:[0-9]+)?$" cm_allow_database_http
  SetEnvIf Host "^127\.0\.0\.1(:[0-9]+)?$" cm_allow_database_http
</IfModule>
<IfModule mod_authz_core.c>
  <RequireAny>
    Require env cm_allow_database_http
    Require all denied
  </RequireAny>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  Allow from localhost
  Allow from 127.0.0.1
</IfModule>
